<fonts xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!--
        Custom Roboto Bold number fonts (generated by tools/gen_number_fonts.py).
        They fill the gap between FONT_NUMBER_MEDIUM (29px digits) and
        FONT_NUMBER_HOT (42px digits), and extend beyond it toward the 84px
        font native fields use in large layouts — Connect IQ does not expose
        the firmware's scalable fonts on Edge devices.
    -->
    <font id="NumberMid" filename="number_mid.fnt" />
    <font id="NumberXlg" filename="number_xlg.fnt" />
    <font id="NumberLrg" filename="number_lrg.fnt" />
    <font id="NumberBig" filename="number_big.fnt" />
</fonts>
